{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/explorer.html" }
  ],
  "headers": [
    {
      "source": "/graph/graph-data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/explorer.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
